# Public — aman dikirim ke browser (di-bundle oleh Next.js)
# Copy file ini ke .env dan isi dengan credentials Supabase kamu
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Database — Drizzle ORM connection (Supabase Postgres)
# Prefer the IPv4-compatible pooler URL from Supabase > Connect for local/Vercel deployments.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:YOUR_PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres
# Optional when DATABASE_URL still uses db.[project-ref].supabase.co:5432
# SUPABASE_DB_REGION=ap-southeast-1

# Base URL aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side alias; use SITE_URL in Vercel if NEXT_PUBLIC_SITE_URL is unavailable.
# SITE_URL=https://our-little-world-blond.vercel.app

# Better Auth secret — generate with: openssl rand(32) -hex
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Server-only — JANGAN PERNAH diberi prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-this-secret
# Private Supabase Storage bucket for uploaded media. The API creates it on first upload if absent.
SUPABASE_STORAGE_BUCKET=media

# Opsional (P1 — rate limiting pakai Upstash Redis)
# Sign up di https://upstash.com dan copy credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=